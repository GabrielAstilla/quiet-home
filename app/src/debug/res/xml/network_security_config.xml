<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP to the emulator's host (10.0.2.2) for the local update test server.
     Release builds have no such exception and refuse non-HTTPS update URLs in code as well. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
