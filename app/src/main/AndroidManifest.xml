<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TV-first, but do not hard-require leanback/touch so it also installs on other boxes. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Updates: only used to check GitHub Releases and download a new APK when you ask
         (or once a day if you turn on automatic checks). No analytics, no account. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets Quiet Home hand a downloaded update to Android's installer (you still confirm it). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Network icon in the top bar (read-only connection status). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Only used when you choose a wallpaper from the Pictures folder. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Package visibility (Android 11+): see every launchable app without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Home apps (e.g. Google TV's launcher). Without this, Android 11+ hides them from this app, so its
             own Home lookup always "found" itself and the Home-button status was wrong. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApp"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">

        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">

            <!-- Lets the system offer this app as the Home app where firmware allows it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Shows up in the Google TV "Apps" list. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Lets key-remapping tools that only list phone-style apps find it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AllAppsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:theme="@style/Theme.Launcher.Overlay" />

        <activity
            android:name=".PickImageActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:theme="@style/Theme.Launcher.Overlay" />

        <activity
            android:name=".WallpaperGalleryActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <activity
            android:name=".ScreensaverActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Launcher.Screensaver" />

        <!-- Optional system screensaver. Google TV may only allow selecting it via ADB (see README). -->
        <service
            android:name=".QuietDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <activity
            android:name=".UpdatesActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <!-- Hands a backup to another Quiet Home install signed with the same key (checked in code). -->
        <provider
            android:name=".BackupProvider"
            android:authorities="${applicationId}.backup"
            android:exported="true" />

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <activity
            android:name=".BackgroundEditorActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
    </application>
</manifest>
