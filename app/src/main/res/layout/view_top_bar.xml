<?xml version="1.0" encoding="utf-8"?>
<!-- Shared top bar: glass capsule with tabs on the left; clock with greeting below it on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="44dp"
    android:paddingTop="22dp"
    android:paddingEnd="44dp"
    android:paddingBottom="8dp">

    <io.github.gabrielastilla.quiethome.GlassView
        android:id="@+id/nav_glass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:padding="6dp">

        <!-- One continuous glass focus pill, drawn behind the stationary labels. -->
        <io.github.gabrielastilla.quiethome.NavPill
            android:id="@+id/nav_pill"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/nav_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_home"
                style="@style/Tab"
                android:text="@string/tab_home" />

            <TextView
                android:id="@+id/tab_apps"
                style="@style/Tab"
                android:layout_marginStart="2dp"
                android:text="@string/tab_apps" />

            <TextView
                android:id="@+id/tab_settings"
                style="@style/Tab"
                android:layout_marginStart="2dp"
                android:text="@string/tab_settings" />
        </LinearLayout>
    </io.github.gabrielastilla.quiethome.GlassView>

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- Clock + greeting. Glass backing is optional (Settings › Clock & Greeting). -->
    <io.github.gabrielastilla.quiethome.GlassView
        android:id="@+id/status_glass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/net"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wifi" />

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="display-regular"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:tag="text-medium"
                android:textColor="#CCFFFFFF"
                android:textSize="17sp" />
        </LinearLayout>
    </io.github.gabrielastilla.quiethome.GlassView>
</LinearLayout>
