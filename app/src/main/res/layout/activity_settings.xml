<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: an overview of section cards, centred over a dimmed Home, and one centred glass panel per
     section. A single centred remote guide sits in its own bottom area inside the safe margins. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#000000" />

    <!-- Everything above the guide. Bottom padding reserves the guide's area (set in code). -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Overview: title + card grid, centred; scrolls only if it can't fit (large text). -->
        <ScrollView
            android:id="@+id/overview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/overview_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:tag="display-semibold"
                    android:text="@string/settings"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp" />

                <LinearLayout
                    android:id="@+id/grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Section panel: centred; its list scrolls inside when a section is taller than the screen. -->
        <io.github.gabrielastilla.quiethome.GlassView
            android:id="@+id/panel"
            android:layout_width="680dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="22dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/crumb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:tag="text-medium"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/section_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:tag="display-semibold"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/section_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:maxWidth="560dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <io.github.gabrielastilla.quiethome.MaxHeightScrollView
                    android:id="@+id/section_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fadingEdgeLength="24dp"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none">

                    <!-- Rows: one fixed-width column, centred as a unit. -->
                    <LinearLayout
                        android:id="@+id/list"
                        android:layout_width="616dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp" />
                </io.github.gabrielastilla.quiethome.MaxHeightScrollView>
            </LinearLayout>
        </io.github.gabrielastilla.quiethome.GlassView>
    </FrameLayout>

    <TextView
        android:id="@+id/settings_hints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="27dp"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowRadius="8"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</FrameLayout>
