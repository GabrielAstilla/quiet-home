<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Background stack: base, crossfading images, dim, overlay, readability gradient. -->
    <io.github.gabrielastilla.quiethome.BackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <include layout="@layout/view_top_bar" />

        <LinearLayout
            android:id="@+id/hero"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:tag="display-semibold"
                    android:maxWidth="640dp"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="54sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:tag="text-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hero_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:maxWidth="680dp"
                android:maxLines="2"
                android:textColor="#D9FFFFFF"
                android:textSize="19sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Single scrolling row; runs to the screen's right edge so the next tile peeks in. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="40dp"
            android:paddingTop="18dp"
            android:paddingEnd="40dp"
            android:paddingBottom="18dp"
            android:scrollbars="none" />

        <!-- Setup state when nothing is pinned yet. -->
        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="44dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <io.github.gabrielastilla.quiethome.GlassView
                android:id="@+id/empty_glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp">

                <TextView
                    android:id="@+id/empty_button"
                    style="@style/Tab"
                    android:paddingStart="26dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="26dp"
                    android:paddingBottom="14dp"
                    android:text="@string/open_all_apps"
                    android:textSize="18sp" />
            </io.github.gabrielastilla.quiethome.GlassView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:maxWidth="520dp"
                android:text="@string/empty_steps"
                android:textColor="#D9FFFFFF"
                android:textSize="17sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Remote guide: its own bottom layer, so the carousel can never push it off screen.
         The content above reserves its height (see HomeActivity.applySafeMargins). -->
        <LinearLayout
        android:id="@+id/hints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="27dp"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="48dp" />
</FrameLayout>
