<?xml version="1.0" encoding="utf-8"?>
<!-- Live preview of the clock and greeting, shown at the top of Settings › Clock & Greeting. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <com.zguy.tvlauncher.GlassView
        android:id="@+id/preview_glass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/preview_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="display-regular"
                android:textColor="@color/text_primary"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/preview_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="text-medium"
                android:textColor="#CCFFFFFF"
                android:textSize="17sp" />
        </LinearLayout>
    </com.zguy.tvlauncher.GlassView>
</FrameLayout>
